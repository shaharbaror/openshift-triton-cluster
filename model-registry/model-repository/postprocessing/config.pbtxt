name: "postprocessing"
backend: "python"
max_batch_size: 16

input [
  {
    name: "last_hidden_state"
    data_type: TYPE_FP32
    dims: [ -1, 384 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]
output [
  {
    name: "embeddings"
    data_type: TYPE_FP32
    dims: [ 384 ]
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 10000
}
